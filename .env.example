# Supabase (client). The anon key is public-safe — protected by Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog (client)
VITE_PUBLIC_POSTHOG_KEY=your-posthog-public-key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OPTIC photo storage on Cloudflare R2 (workers/optic-r2). When set, new
# /optic + /lukeupload photos upload to R2 instead of Supabase Storage.
# Leave unset to keep using Supabase. No trailing slash.
VITE_OPTIC_R2_URL=https://optic-photos.YOUR-SUBDOMAIN.workers.dev
